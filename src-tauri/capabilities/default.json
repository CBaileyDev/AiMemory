{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for Claude-Mem desktop",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "bin/claude-mem-worker",
          "sidecar": true,
          "args": ["--daemon"]
        }
      ]
    }
  ]
}
